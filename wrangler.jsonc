{
  "name": "fresh-ai-trader",
  "main": "janggo-worker.mjs",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "3b04ac24997341449fa82775ef0646ca"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 3-10 * * MON-FRI"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
