{
  "name": "fresh-ai-trader",
  "main": "janggo-worker.mjs",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
